<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:designPath="/libs/settings/wcm/designs/default"
        cq:lastModified="{Date}2025-11-05T09:09:04.538-08:00"
        cq:lastModifiedBy="admin"
        cq:tags="[workflow:wcm]"
        cq:template="/libs/cq/workflow/templates/model"
        jcr:description="Approval workflow for Spanish content under /content/larasoft/us/es - enforces review before publishing"
        jcr:primaryType="cq:PageContent"
        jcr:title="Spanish Content Approval Workflow"
        sling:resourceType="cq/workflow/components/pages/model"
        lastSynced="{Date}2025-11-05T09:09:07.342-08:00">
        <flow
            jcr:primaryType="nt:unstructured"
            sling:resourceType="foundation/components/parsys">
            <process
                jcr:description="Verify workflow is not being bypassed"
                jcr:primaryType="nt:unstructured"
                jcr:title="Check Workflow State"
                sling:resourceType="cq/workflow/components/model/process">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PROCESS="com.larasoft.core.workflows.WorkflowEnforcementProcess"
                    PROCESS_AUTO_ADVANCE="true"/>
            </process>
            <participant
                jcr:description="Reviewer must approve, reject, or request changes"
                jcr:primaryType="nt:unstructured"
                jcr:title="Spanish Content Review"
                sling:resourceType="cq/workflow/components/model/participant">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PARTICIPANT="reviewer-spanish"
                    PPARTICIPANT="reviewer-spanish"
                    PROCESS_AUTO_ADVANCE="false">
                    <workflowActions jcr:primaryType="nt:unstructured">
                        <approve
                            jcr:primaryType="nt:unstructured"
                            label="Approve"
                            route="node2_to_node3_approve"/>
                        <reject
                            jcr:primaryType="nt:unstructured"
                            label="Reject"
                            route="node2_to_node4_reject"/>
                        <requestChanges
                            jcr:primaryType="nt:unstructured"
                            label="Request Changes"
                            route="node2_to_node5_requestChanges"/>
                    </workflowActions>
                </metaData>
            </participant>
            <process_1313880425
                jcr:description="Mark content as approved - editor can now publish"
                jcr:primaryType="nt:unstructured"
                jcr:title="Mark as Approved"
                sling:resourceType="cq/workflow/components/model/process">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PROCESS="com.larasoft.core.workflows.ApprovalMarkingProcess"
                    PROCESS_AUTO_ADVANCE="true"/>
            </process_1313880425>
            <process_513636853
                jcr:description="Send back to editor for modifications"
                jcr:primaryType="nt:unstructured"
                jcr:title="Request Changes Handler"
                sling:resourceType="cq/workflow/components/model/process">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PROCESS="com.larasoft.core.workflows.RequestChangesProcess"
                    PROCESS_AUTO_ADVANCE="true"/>
            </process_513636853>
            <participant_notification
                jcr:description="Notify the original editor that their content has been approved and is ready to publish"
                jcr:primaryType="nt:unstructured"
                jcr:title="Notify Editor - Content Approved"
                sling:resourceType="cq/workflow/components/model/participant">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PARTICIPANT="$(initiator)"
                    PROCESS_AUTO_ADVANCE="false"
                    taskInstructions="✅ Your Spanish content has been APPROVED and is ready to publish!&#xa;&#xa;Page: $(payload)&#xa;&#xa;You can now publish this page from the Sites console.&#xa;&#xa;Click 'Complete' to acknowledge this notification."
                    taskTitle="Content Approved - Ready to Publish"/>
            </participant_notification>
            <participant_rejection_notification
                jcr:description="Notify the original editor that their content has been rejected"
                jcr:primaryType="nt:unstructured"
                jcr:title="Notify Editor - Content Rejected"
                sling:resourceType="cq/workflow/components/model/participant">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PARTICIPANT="$(initiator)"
                    PROCESS_AUTO_ADVANCE="false"
                    taskInstructions="❌ Your Spanish content has been REJECTED.&#xa;&#xa;Page: $(payload)&#xa;&#xa;Please review the rejection comments, make necessary changes, and request approval again.&#xa;&#xa;Click 'Complete' to acknowledge this notification."
                    taskTitle="Content Rejected - Changes Required"/>
            </participant_rejection_notification>
            <participant_changes_notification
                jcr:description="Notify the original editor that changes have been requested"
                jcr:primaryType="nt:unstructured"
                jcr:title="Notify Editor - Changes Requested"
                sling:resourceType="cq/workflow/components/model/participant">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PARTICIPANT="$(initiator)"
                    PROCESS_AUTO_ADVANCE="false"
                    taskInstructions="🔄 The reviewer has requested changes to your Spanish content.&#xa;&#xa;Page: $(payload)&#xa;&#xa;Please review the feedback, make the requested changes, and request approval again.&#xa;&#xa;Click 'Complete' to acknowledge this notification."
                    taskTitle="Changes Requested - Action Required"/>
            </participant_changes_notification>
        </flow>
    </jcr:content>
</jcr:root>
