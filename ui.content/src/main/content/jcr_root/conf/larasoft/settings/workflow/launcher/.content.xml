<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="sling:Folder">
    <spanish-content-approval-launcher
        jcr:primaryType="sling:Folder"
        jcr:title="Spanish Content Approval Launcher"
        description="Automatically triggers Spanish content approval workflow for pages under /content/larasoft/es"
        condition=""
        enabled="{Boolean}true"
        eventType="1"
        excludeList="[/content/larasoft/es/.*/(jcr:content|rep:policy)]"
        glob="/content/larasoft/es/**"
        nodetype="cq:Page"
        workflow="/conf/larasoft/settings/workflow/models/spanish-content-approval">
        <metaData jcr:primaryType="nt:unstructured">
            <runModes 
                jcr:primaryType="nt:unstructured"
                runMode="author"/>
        </metaData>
    </spanish-content-approval-launcher>
</jcr:root>

